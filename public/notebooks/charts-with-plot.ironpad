--ip-plot-series-1, #E03F59)\\\" stroke=\\\"none\\\"/>\\n<text x=\\\"141\\\" y=\\\"69\\\" dy=\\\"-0.5ex\\\" text-anchor=\\\"middle\\\" font-family=\\\"sans-serif\\\" font-size=\\\"8.870967741935484\\\" opacity=\\\"1\\\" fill=\\\"var(--ip-plot-text, #82828C)\\\">\\n92.0\\n</text>\\n<text x=\\\"285\\\" y=\\\"111\\\" dy=\\\"-0.5ex\\\" text-anchor=\\\"middle\\\" font-family=\\\"sans-serif\\\" font-size=\\\"8.870967741935484\\\" opacity=\\\"1\\\" fill=\\\"var(--ip-plot-text, #82828C)\\\">\\n78.0\\n</text>\\n<text x=\\\"429\\\" y=\\\"151\\\" dy=\\\"-0.5ex\\\" text-anchor=\\\"middle\\\" font-family=\\\"sans-serif\\\" font-size=\\\"8.870967741935484\\\" opacity=\\\"1\\\" fill=\\\"var(--ip-plot-text, #82828C)\\\">\\n65.0\\n</text>\\n<text x=\\\"573\\\" y=\\\"172\\\" dy=\\\"-0.5ex\\\" text-anchor=\\\"middle\\\" font-family=\\\"sans-serif\\\" font-size=\\\"8.870967741935484\\\" opacity=\\\"1\\\" fill=\\\"var(--ip-plot-text, #82828C)\\\">\\n58.0\\n</text>\\n<text x=\\\"717\\\" y=\\\"212\\\" dy=\\\"-0.5ex\\\" text-anchor=\\\"middle\\\" font-family=\\\"sans-serif\\\" font-size=\\\"8.870967741935484\\\" opacity=\\\"1\\\" fill=\\\"var(--ip-plot-text, #82828C)\\\">\\n45.0\\n</text>\\n</svg>\\n\"}]"
