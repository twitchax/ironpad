79\\\" opacity=\\\"1\\\" fill=\\\"#E94560\\\" stroke=\\\"none\\\"/>\\n<rect x=\\\"677\\\" y=\\\"200\\\" width=\\\"44\\\" height=\\\"149\\\" opacity=\\\"1\\\" fill=\\\"#E94560\\\" stroke=\\\"none\\\"/>\\n<rect x=\\\"737\\\" y=\\\"222\\\" width=\\\"44\\\" height=\\\"127\\\" opacity=\\\"1\\\" fill=\\\"#E94560\\\" stroke=\\\"none\\\"/>\\n</svg>\\n\"}]"
