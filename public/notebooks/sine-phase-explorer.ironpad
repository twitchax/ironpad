{
  "version": 1,
  "id": "00000000-0000-0000-0000-000000000200",
  "title": "Sine/Cosine Phase Explorer",
  "created_at": "2026-01-01T00:00:00Z",
  "updated_at": "2026-01-01T00:00:00Z",
  "shared_cargo_toml": "[profile.release]\nopt-level = 1\nlto = false\ncodegen-units = 16",
  "description": "Interactively explore phase shifts applied to sine and cosine waves. Use the slider to shift the phase φ and watch the waves respond in real time via LiveView SVG rendering.",
