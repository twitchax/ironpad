{
  "version": 1,
  "id": "00000000-0000-0000-0000-000000000108",
  "title": "Double Pendulum",
  "created_at": "2026-01-01T00:00:00Z",
  "updated_at": "2026-01-01T00:00:00Z",
  "shared_cargo_toml": "[profile.release]\nopt-level = 1\nlto = false\ncodegen-units = 16",
  "cells": [
    {
      "id": "cell_0",
      "order": 0,
      "label": "Introduction",
      "cell_type": "Markdown",
      "source": "# Double Pendulum \u2014 Chaos in Motion \ud83c\udfaf\n\nThe **double pendulum** is one of the simplest physical systems that exhibits **chaotic behavior**. Two rigid rods connected end-to-end, swinging under gravity \u2014 yet the motion is wildly unpredictable.\n\n## Lagrangian Mechanics\n\nInstead of tracking forces, we use the **Lagrangian** L = T \u2212 V (kinetic minus potential energy) and derive equations of motion from:\n\n> **d/dt (\u2202L/\u2202\u03b8\u0307) \u2212 \u2202L/\u2202\u03b8 = 0**\n\nFor a double pendulum with masses m\u2081, m\u2082 and rod lengths L\u2081, L\u2082, the resulting equations are coupled, nonlinear, and **have no closed-form solution** \u2014 making numerical simulation essential.\n\n## This Notebook\n\nThis cell implements the `Simulation` trait to produce a **live animation** at 60 FPS. The second bob leaves a fading trail that reveals the chaotic trajectory in real time.\n\n**Parameters**: m\u2081 = m\u2082 = 1 kg, L\u2081 = L\u2082 = 1 m, g = 9.81 m/s\u00b2, \u03b8\u2081 = \u03b8\u2082 = \u03c0/2\n\n**Integration**: 4th-order Runge-Kutta with 10 sub-steps per frame for stability.",
      "cargo_toml": null
    },
    {
      "id": "cell_1",
      "order": 1,
      "label": "Live Simulation",
      "cell_type": "Code",
      "source": "// Double Pendulum \u2014 live Simulation trait implementation.\n//\n// RK4 integration of the Lagrangian equations of motion with a fading\n// trail that reveals the chaotic trajectory of the second bob.\n\nconst WIDTH: u32 = 800;\nconst HEIGHT: u32 = 800;\nconst G: f64 = 9.81;\nconst M1: f64 = 1.0;\nconst M2: f64 = 1.0;\nconst L1: f64 = 1.0;\nconst L2: f64 = 1.0;\nconst SCALE: f64 = 267.0;\nconst PIVOT_X: f64 = 400.0;\nconst PIVOT_Y: f64 = 178.0;\nconst MAX_TRAIL: usize = 500;\nconst SUB_STEPS: usize = 10;\nconst DT: f64 = 1.0 / 60.0;\n\nstruct DoublePendulum {\n    theta1: f64,\n    theta2: f64,\n    omega1: f64,\n    omega2: f64,\n    trail: Vec<(f64, f64)>,\n}\n\n// \u2500\u2500 Physics \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n/// Compute derivatives [d\u03b8\u2081/dt, d\u03b8\u2082/dt, d\u03c9\u2081/dt, d\u03c9\u2082/dt] from the\n/// Lagrangian equations of motion for the double pendulum.\nfn derivs(t1: f64, t2: f64, w1: f64, w2: f64) -> [f64; 4] {\n    let delta = t1 - t2;\n    let sin_d = delta.sin();\n    let cos_d = delta.cos();\n    let denom = 2.0 * M1 + M2 - M2 * (2.0 * delta).cos();\n\n    let alpha1 = (-G * (2.0 * M1 + M2) * t1.sin()\n        - M2 * G * (t1 - 2.0 * t2).sin()\n        - 2.0 * sin_d * M2 * (w2 * w2 * L2 + w1 * w1 * L1 * cos_d))\n        / (L1 * denom);\n\n    let alpha2 = (2.0 * sin_d\n        * (w1 * w1 * L1 * (M1 + M2)\n            + G * (M1 + M2) * t1.cos()\n            + w2 * w2 * L2 * M2 * cos_d))\n        / (L2 * denom);\n\n    [w1, w2, alpha1, alpha2]\n}\n\n/// Advance the state by one RK4 step of size `dt`.\nfn rk4_step(t1: &mut f64, t2: &mut f64, w1: &mut f64, w2: &mut f64, dt: f64) {\n    let k1 = derivs(*t1, *t2, *w1, *w2);\n    let k2 = derivs(\n        *t1 + 0.5 * dt * k1[0], *t2 + 0.5 * dt * k1[1],\n        *w1 + 0.5 * dt * k1[2], *w2 + 0.5 * dt * k1[3],\n    );\n    let k3 = derivs(\n        *t1 + 0.5 * dt * k2[0], *t2 + 0.5 * dt * k2[1],\n        *w1 + 0.5 * dt * k2[2], *w2 + 0.5 * dt * k2[3],\n    );\n    let k4 = derivs(\n        *t1 + dt * k3[0], *t2 + dt * k3[1],\n        *w1 + dt * k3[2], *w2 + dt * k3[3],\n    );\n\n    *t1 += (dt / 6.0) * (k1[0] + 2.0 * k2[0] + 2.0 * k3[0] + k4[0]);\n    *t2 += (dt / 6.0) * (k1[1] + 2.0 * k2[1] + 2.0 * k3[1] + k4[1]);\n    *w1 += (dt / 6.0) * (k1[2] + 2.0 * k2[2] + 2.0 * k3[2] + k4[2]);\n    *w2 += (dt / 6.0) * (k1[3] + 2.0 * k2[3] + 2.0 * k3[3] + k4[3]);\n}\n\n// \u2500\u2500 Drawing helpers \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nfn draw_line(canvas: &mut Canvas, x0: i32, y0: i32, x1: i32, y1: i32, color: (u8, u8, u8)) {\n    let dx = (x1 - x0).abs();\n    let dy = -(y1 - y0).abs();\n    let sx: i32 = if x0 < x1 { 1 } else { -1 };\n    let sy: i32 = if y0 < y1 { 1 } else { -1 };\n    let mut err = dx + dy;\n    let (mut x, mut y) = (x0, y0);\n\n    loop {\n        if x >= 0 && y >= 0 {\n            canvas.set_pixel(x as u32, y as u32, color);\n        }\n        if x == x1 && y == y1 { break; }\n        let e2 = 2 * err;\n        if e2 >= dy { err += dy; x += sx; }\n        if e2 <= dx { err += dx; y += sy; }\n    }\n}\n\nfn draw_thick_line(\n    canvas: &mut Canvas,\n    x0: i32, y0: i32, x1: i32, y1: i32,\n    thickness: i32, color: (u8, u8, u8),\n) {\n    for oy in -thickness..=thickness {\n        for ox in -thickness..=thickness {\n            if ox * ox + oy * oy <= thickness * thickness {\n                draw_line(canvas, x0 + ox, y0 + oy, x1 + ox, y1 + oy, color);\n            }\n        }\n    }\n}\n\nfn draw_circle(canvas: &mut Canvas, cx: i32, cy: i32, r: i32, color: (u8, u8, u8)) {\n    for dy in -r..=r {\n        for dx in -r..=r {\n            if dx * dx + dy * dy <= r * r {\n                let px = cx + dx;\n                let py = cy + dy;\n                if px >= 0 && py >= 0 {\n                    canvas.set_pixel(px as u32, py as u32, color);\n                }\n            }\n        }\n    }\n}\n\n// \u2500\u2500 Simulation trait \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\nimpl Simulation for DoublePendulum {\n    fn init() -> Self {\n        Self {\n            theta1: std::f64::consts::FRAC_PI_2,\n            theta2: std::f64::consts::FRAC_PI_2,\n            omega1: 0.0,\n            omega2: 0.0,\n            trail: Vec::with_capacity(MAX_TRAIL),\n        }\n    }\n\n    fn tick(&mut self) -> Canvas {\n        // Sub-stepped RK4 integration for numerical stability.\n        let sub_dt = DT / SUB_STEPS as f64;\n        for _ in 0..SUB_STEPS {\n            rk4_step(\n                &mut self.theta1, &mut self.theta2,\n                &mut self.omega1, &mut self.omega2,\n                sub_dt,\n            );\n        }\n\n        // Bob positions in pixel space.\n        let x1 = PIVOT_X + SCALE * self.theta1.sin();\n        let y1 = PIVOT_Y + SCALE * self.theta1.cos();\n        let x2 = x1 + SCALE * self.theta2.sin();\n        let y2 = y1 + SCALE * self.theta2.cos();\n\n        // Append second bob position to the trail.\n        self.trail.push((x2, y2));\n        if self.trail.len() > MAX_TRAIL {\n            self.trail.remove(0);\n        }\n\n        // \u2500\u2500 Render \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n        let mut canvas = Canvas::new(WIDTH, HEIGHT);\n        canvas.fill((10, 10, 20));\n\n        // Fading trail: old = dark purple, new = bright magenta.\n        let n = self.trail.len();\n        for (i, &(tx, ty)) in self.trail.iter().enumerate() {\n            let t = i as f64 / n as f64;\n            let r = (40.0 + 215.0 * t) as u8;\n            let g = (10.0 + 70.0 * t) as u8;\n            let b = (60.0 + 140.0 * t) as u8;\n            let px = tx as i32;\n            let py = ty as i32;\n            if px >= 0 && py >= 0 {\n                let ux = px as u32;\n                let uy = py as u32;\n                canvas.set_pixel(ux, uy, (r, g, b));\n                canvas.set_pixel(ux + 1, uy, (r, g, b));\n                canvas.set_pixel(ux, uy + 1, (r, g, b));\n                canvas.set_pixel(ux + 1, uy + 1, (r, g, b));\n            }\n        }\n\n        // Pendulum arms.\n        let arm_color = (200, 200, 210);\n        draw_thick_line(\n            &mut canvas,\n            PIVOT_X as i32, PIVOT_Y as i32, x1 as i32, y1 as i32,\n            1, arm_color,\n        );\n        draw_thick_line(\n            &mut canvas,\n            x1 as i32, y1 as i32, x2 as i32, y2 as i32,\n            1, arm_color,\n        );\n\n        // Pivot.\n        draw_circle(&mut canvas, PIVOT_X as i32, PIVOT_Y as i32, 3, (150, 150, 160));\n\n        // Bobs.\n        draw_circle(&mut canvas, x1 as i32, y1 as i32, 6, (0, 220, 255));\n        draw_circle(&mut canvas, x2 as i32, y2 as i32, 6, (255, 80, 200));\n\n        canvas\n    }\n\n    fn fps() -> u32 {\n        60\n    }\n}",
      "cargo_toml": null
    }
  ]
}
