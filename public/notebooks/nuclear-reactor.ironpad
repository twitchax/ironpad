{
  "version": 1,
  "id": "00000000-0000-0000-0000-000000000114",
  "title": "Nuclear Reactor",
  "created_at": "2026-03-15T00:00:00Z",
  "updated_at": "2026-03-16T05:06:00Z",
  "shared_cargo_toml": null,
  "cells": [
    {
      "id": "cell_0",
      "order": 0,
      "label": "Reactor Simulation",
      "cell_type": "Code",
      "source": "/// # 2D Nuclear Reactor Neutron Diffusion Simulation\n///\n/// Simulates a 2D cross-section of a cylindrical reactor with a\n/// withdrawable control rod.  The physics model uses one-group\n/// neutron diffusion with six groups of delayed-neutron precursors.\n///\n/// ## Physics\n///\n/// **One-group diffusion equation** (Stacey, *Nuclear Reactor Physics*, §5.1):\n///\n///   ∂φ/∂t = v [ D ∇²φ − Σₐ φ + (1−β) ν Σ_f φ + Σᵢ λᵢ Cᵢ ] + S\n///\n/// **Precursor equations** (Keepin, *Physics of Nuclear Kinetics*, Ch. 4):\n///\n///   ∂Cᵢ/∂t = βᵢ ν Σ_f φ − λᵢ Cᵢ        (i = 1..6)\n///\n/// where:\n///   φ  = scalar neutron flux\n///   v  = neutron speed (pedagogically scaled for visibility)\n///   D  = diffusion coefficient\n///   Σₐ = macroscopic absorption cross section\n///   νΣ_f = macroscopic fission production rate\n///   βᵢ, λᵢ = delayed-neutron fraction & decay constant for group i\n///   Cᵢ = precursor concentration for group i\n///   S  = fixed external neutron source\n///\n/// ## Control Rod Model\n///\n/// A vertical absorber blade (B₄C / Ag-In-Cd) occupies a narrow channel\n/// at the core centre.  The rod inserts from the **top** of the core.\n/// Cross-section values inside the rod differ from the fuel:\n///\n///   - **Rod in**:  Σₐ = 0.40 cm⁻¹, D = 0.40 cm  (strong absorber)\n///   - **Rod out**: Σₐ = 0.02 cm⁻¹, D = 0.80 cm  (water channel)\n///\n/// The rod withdraws automatically until k_eff ≥ 1.0, which is tuned\n/// to occur at approximately 75 % rod withdrawal.\n///\n/// ## k_eff Gauge\n///\n/// A vertical colour-bar gauge on the left side of the canvas shows\n/// the effective multiplication factor k_eff in real time.  The gauge\n/// spans k ∈ [0, 2] with a white marker at k = 1 (criticality).\n///\n/// ## Delayed-Neutron Data\n///\n/// Six-group parameters for thermal-neutron fission of U-235\n/// (Keepin, *Physics of Nuclear Kinetics*, Table 4-5):\n///\n///   | Group | βᵢ       | λᵢ (s⁻¹)  | Half-life  |\n///   |-------|----------|-----------|------------|\n///   |   1   | 0.000215 | 0.0124    | 55.9 s     |\n///   |   2   | 0.001424 | 0.0305    | 22.7 s     |\n///   |   3   | 0.001274 | 0.111     |  6.2 s     |\n///   |   4   | 0.002568 | 0.301     |  2.3 s     |\n///   |   5   | 0.000748 | 1.14      |  0.61 s    |\n///   |   6   | 0.000273 | 3.01      |  0.23 s    |\n///\n/// Total β = 0.0065 (effective delayed-neutron fraction for U-235).\n///\n/// ## References\n///\n///   - Stacey, W. M.  *Nuclear Reactor Physics*.  Wiley, 2nd ed., 2007.\n///   - Keepin, G. R.  *Physics of Nuclear Kinetics*.  Addison-Wesley, 1965.\n///   - Lamarsh, J. R. & Baratta, A. J.  *Introduction to Nuclear Engineering*.\n///     Prentice Hall, 4th ed., 2018.\n///   - Duderstadt, J. J. & Hamilton, L. J.  *Nuclear Reactor Analysis*.\n///     Wiley, 1976.\n\n// ── Grid & geometry ───────────────────────────────────────────────────────\n\nconst N: usize = 300;        // grid cells per side\nconst CANVAS_W: u32 = 620;   // extra 20 px on left for k-gauge\nconst CANVAS_H: u32 = 600;   // simulation area is 600x600\nconst SIM_W: u32 = 600;\nconst GAUGE_W: u32 = 20;     // width of the k_eff gauge bar\nconst CENTER: usize = N / 2; // grid centre\nconst R_CORE: usize = 105;   // core radius in grid cells\nconst R_REFL: usize = 135;   // reflector outer radius\nconst ROD_HALF_W: usize = 6;  // control rod half-width in grid cells\n\n/// Seven control rod blade positions (x-coordinates), evenly distributed\n/// across the core.  Each rod is a vertical blade of width 2×ROD_HALF_W.\nconst ROD_POSITIONS: [usize; 7] = [\n    CENTER - 78, CENTER - 52, CENTER - 26, CENTER,\n    CENTER + 26, CENTER + 52, CENTER + 78,\n];\n\n// ── Material properties ───────────────────────────────────────────────────\n// (Duderstadt & Hamilton, Table 4.1, simplified one-group values)\n\nconst D_FUEL: f64 = 1.10;    // fuel diffusion coefficient (cm)\nconst D_REFL: f64 = 1.50;    // reflector diffusion coefficient\nconst D_ROD:  f64 = 0.20;    // control rod (B₄C / Ag-In-Cd), low diffusion\nconst D_WATER: f64 = 0.80;   // water channel (rod withdrawn)\n\nconst SA_FUEL: f64 = 0.082;  // fuel absorption cross section (cm⁻¹)\nconst SA_REFL: f64 = 0.005;  // reflector absorption\nconst SA_ROD:  f64 = 3.0;    // rod absorption (very strong absorber)\nconst SA_WATER: f64 = 0.02;  // water channel absorption\n\n/// Void (vacuum) — diffusion theory doesn't strictly apply, but we\n/// approximate free-streaming with a large D and tiny Σₐ representing\n/// escape from the 2D simulation plane.\nconst D_VOID:  f64 = 1.8;    // CFL-safe: 4·1.8·50·dt = 0.80 < 1\nconst SA_VOID: f64 = 0.001;\n\n/// Fission production cross section ν Σ_f (cm⁻¹).\n/// Tuned so that k_eff ≈ 1.0 when rod is ~75 % withdrawn.\nconst NUSF: f64 = 0.095;\n\n/// Pedagogically scaled neutron speed (cm/s).\n/// Real thermal neutrons travel at ~2.2 × 10⁵ cm/s; we slow them\n/// so the simulation timescale is O(seconds) for visual clarity.\n/// (Lamarsh & Baratta, §3.3 — E = 0.0253 eV ⇒ v = 2200 m/s)\nconst V: f64 = 50.0;\n\n/// Fixed external source strength (neutrons / cm³ / s).\n/// Placed off-centre to avoid the rod channel.\nconst SOURCE_STRENGTH: f64 = 1.0;\nconst SOURCE_X: usize = CENTER + 37;\nconst SOURCE_Y: usize = CENTER;\n\n// ── Delayed neutron parameters (Keepin, Table 4-5, U-235 thermal) ─────\n\nconst BETA: [f64; 6] = [\n    0.000215, 0.001424, 0.001274,\n    0.002568, 0.000748, 0.000273,\n];\nconst LAMBDA: [f64; 6] = [\n    0.0124, 0.0305, 0.111,\n    0.301,  1.14,   3.01,\n];\n/// Total delayed-neutron fraction β_total = Σ βᵢ = 0.0065.\nconst BETA_TOTAL: f64 = 0.0065;\n\n// ── Region classification ─────────────────────────────────────────────────\n\n#[derive(Clone, Copy, PartialEq)]\nenum BaseRegion {\n    Fuel,\n    RodChannel,\n    Reflector,\n    Void,\n}\n\n// ── Simulation state ──────────────────────────────────────────────────────\n\nstruct ReactorSim {\n    /// Scalar neutron flux φ(x,y).\n    phi: Vec<f64>,\n    /// Delayed-neutron precursor concentrations Cᵢ(x,y), for groups 1–6.\n    precursors: [Vec<f64>; 6],\n    /// Pre-classified base region for each cell (ignoring rod state).\n    region: Vec<BaseRegion>,\n    /// Control rod depth: 1.0 = fully inserted (from top), 0.0 = fully withdrawn.\n    rod_depth: f64,\n    /// Current k_eff computed from the material balance.\n    k_eff: f64,\n    /// Exponentially smoothed k_eff for stable display.\n    k_eff_smooth: f64,\n    /// Simulation time in seconds.\n    time: f64,\n    /// Whether the rod has finished initial withdrawal and is oscillating.\n    oscillating: bool,\n    /// Frame counter for timing.\n    frame: u64,\n}\n\n// ── Helpers ───────────────────────────────────────────────────────────────\n\n/// Distance from grid cell (i,j) to the core centre.\nfn dist(i: usize, j: usize) -> f64 {\n    let di = i as f64 - CENTER as f64;\n    let dj = j as f64 - CENTER as f64;\n    (di * di + dj * dj).sqrt()\n}\n\n/// Classify each cell into its base region (independent of rod position).\nfn classify_regions() -> Vec<BaseRegion> {\n    let mut region = vec![BaseRegion::Void; N * N];\n    for j in 0..N {\n        for i in 0..N {\n            let r = dist(i, j);\n            if r <= R_CORE as f64 {\n                // Inside core: check if this cell is in any rod channel.\n                let in_rod = ROD_POSITIONS.iter().any(|&cx| {\n                    (i as isize - cx as isize).unsigned_abs() < ROD_HALF_W\n                });\n                if in_rod {\n                    region[j * N + i] = BaseRegion::RodChannel;\n                } else {\n                    region[j * N + i] = BaseRegion::Fuel;\n                }\n            } else if r <= R_REFL as f64 {\n                region[j * N + i] = BaseRegion::Reflector;\n            }\n        }\n    }\n    region\n}\n\n/// Get the material properties (D, Σₐ, νΣ_f) for a cell, given rod state.\n///\n/// The rod inserts from the TOP of the core.  `rod_depth` ∈ [0, 1]:\n///   - rod_depth = 1.0 → fully inserted (rod fills entire channel)\n///   - rod_depth = 0.0 → fully withdrawn (channel is all water)\n///\n/// The rod tip y-coordinate (in grid cells from the top of the core):\n///   rod_end_y = (CENTER − R_CORE) + rod_depth × 2 × R_CORE\n///\n/// Grid cells in the rod channel with j < rod_end_y contain the absorber;\n/// those with j ≥ rod_end_y contain water.\nfn material_at(\n    i: usize,\n    j: usize,\n    base: BaseRegion,\n    rod_depth: f64,\n) -> (f64, f64, f64) {\n    match base {\n        BaseRegion::Fuel      => (D_FUEL, SA_FUEL, NUSF),\n        BaseRegion::Reflector => (D_REFL, SA_REFL, 0.0),\n        BaseRegion::Void      => (D_VOID, SA_VOID, 0.0),\n        BaseRegion::RodChannel => {\n            // Rod tip position (grid row, measured from top of domain).\n            let core_top = CENTER as f64 - R_CORE as f64;\n            let rod_end_y = core_top + rod_depth * 2.0 * R_CORE as f64;\n            if (j as f64) < rod_end_y {\n                // Rod is present here (absorber).\n                (D_ROD, SA_ROD, 0.0)\n            } else {\n                // Rod withdrawn from here (water channel).\n                (D_WATER, SA_WATER, 0.0)\n            }\n        }\n    }\n}\n\n/// Compute k_eff from the current flux distribution using the material balance:\n///\n///   k_eff = Σ(νΣ_f · φ) / [ Σ(Σₐ · φ) + leakage ]\n///\n/// where leakage ≈ −Σ(D · ∇²φ) summed over all cells.\n/// (Stacey, §5.3, Eq. 5.17 — eigenvalue form of the diffusion equation)\nfn compute_k_eff(\n    phi: &[f64],\n    region: &[BaseRegion],\n    rod_depth: f64,\n) -> f64 {\n    let mut fission_sum = 0.0;\n    let mut absorption_sum = 0.0;\n    let mut leakage_sum = 0.0;\n\n    for j in 1..N - 1 {\n        for i in 1..N - 1 {\n            let idx = j * N + i;\n\n            let (d, sa, nusf) = material_at(i, j, region[idx], rod_depth);\n            let flux = phi[idx];\n\n            fission_sum += nusf * flux;\n            absorption_sum += sa * flux;\n\n            // Five-point Laplacian: ∇²φ ≈ φ(i+1)+φ(i−1)+φ(j+1)+φ(j−1) − 4φ\n            let lap = phi[idx + 1] + phi[idx - 1]\n                    + phi[(j + 1) * N + i] + phi[(j - 1) * N + i]\n                    - 4.0 * flux;\n            // Leakage = −D ∇²φ (positive = neutrons leaving the cell)\n            leakage_sum += -d * lap;\n        }\n    }\n\n    let loss = absorption_sum + leakage_sum;\n    if loss.abs() < 1e-30 {\n        0.0\n    } else {\n        fission_sum / loss\n    }\n}\n\n// ── Colour helpers ────────────────────────────────────────────────────────\n\n/// Map a value t ∈ [0, 1] to a \"hot plasma\" colour ramp.\nfn plasma(t: f64) -> (u8, u8, u8) {\n    let t = t.clamp(0.0, 1.0);\n    // Black → deep blue → purple → orange → bright yellow\n    let r = (1.5 * t - 0.2).clamp(0.0, 1.0);\n    let g = (1.8 * t - 0.7).clamp(0.0, 1.0);\n    let b = (0.5 + 1.5 * (0.5 - (t - 0.35).abs())).clamp(0.0, 1.0);\n    (\n        (r * 255.0) as u8,\n        (g * 255.0) as u8,\n        (b * 255.0) as u8,\n    )\n}\n\n/// Colour for the k_eff gauge: blue(sub) → green(critical) → red(super).\nfn k_color(k: f64) -> (u8, u8, u8) {\n    if k < 1.0 {\n        // Blue → green as k goes 0 → 1\n        let t = k.clamp(0.0, 1.0);\n        let r = 0;\n        let g = (t * 200.0) as u8;\n        let b = ((1.0 - t) * 200.0) as u8;\n        (r, g, b)\n    } else {\n        // Green → red as k goes 1 → 2\n        let t = (k - 1.0).clamp(0.0, 1.0);\n        let r = (t * 255.0) as u8;\n        let g = ((1.0 - t) * 200.0) as u8;\n        let b = 0;\n        (r, g, b)\n    }\n}\n\n// ── Simulation trait impl ─────────────────────────────────────────────────\n\nimpl Simulation for ReactorSim {\n    fn init() -> Self {\n        let n2 = N * N;\n        let region = classify_regions();\n\n        // Seed the flux with a cosine-like profile in the fuel region\n        // so the fundamental eigenmode develops quickly.  Without this,\n        // the flux starts at zero and k_eff is meaningless for many frames.\n        let mut phi = vec![0.0; n2];\n        for j in 0..N {\n            for i in 0..N {\n                let idx = j * N + i;\n                if region[idx] == BaseRegion::Fuel {\n                    let r = dist(i, j) / R_CORE as f64;\n                    // Approximate J0 profile: peak at centre, zero at edge.\n                    phi[idx] = (1.0 - r * r).max(0.0) * 0.01;\n                }\n            }\n        }\n\n        let precursors = std::array::from_fn(|_| vec![0.0; n2]);\n\n        ReactorSim {\n            phi,\n            precursors,\n            region,\n            rod_depth: 1.0,  // start fully inserted\n            k_eff: 0.0,\n            k_eff_smooth: 0.0,\n            time: 0.0,\n            oscillating: false,\n            frame: 0,\n        }\n    }\n\n    fn tick(&mut self) -> Canvas {\n        // ── Time stepping ─────────────────────────────────────────────\n        // CFL stability for the 2D explicit Euler diffusion scheme:\n        //   4 · D_max · v · dt  <  1       (2D, 5-point stencil)\n        // D_max = 1.5 (reflector), v = 50 → dt < 1/300 ≈ 0.00333\n        // 15 sub-steps at 30 fps → dt = 1/450 ≈ 0.00222\n        // Check: 4 · 1.5 · 50 · 0.00222 = 0.667 < 1  ✓\n        let dt: f64 = 1.0 / (30.0 * 15.0);\n        let sub_steps = 15;\n\n        // ── Control rod motion ─────────────────────────────────────────\n        // Phase 1: withdraw from fully-in (1.0) to ~75% out (0.25).\n        // Phase 2: oscillate around 0.25 with amplitude 0.20 and period\n        //          T = 8 s, chosen to excite delayed-neutron groups 3–5\n        //          (half-lives 0.61–6.2 s, λ = 0.111–1.14 s⁻¹).\n        //\n        // Because the rod inserts from the TOP, the upper hemisphere\n        // feels the rod's absorption first on each downstroke, creating\n        // a top-bottom flux asymmetry that lags behind the rod motion\n        // due to delayed-neutron precursor buildup.\n        self.time += 1.0 / 30.0;\n\n        if !self.oscillating {\n            // Phase 1: withdraw to 50% out.\n            let withdraw_rate = 0.5 / 30.0;\n            self.rod_depth = (self.rod_depth - withdraw_rate).max(0.50);\n            if self.rod_depth <= 0.50 {\n                self.oscillating = true;\n            }\n        } else {\n            // Phase 2: deep sinusoidal oscillation.\n            //   rod_depth = 0.50 + 0.35 · sin(2π t / 8)\n            // Sweeps between 0.15 (85% out) and 0.85 (15% out),\n            // driving the rod through most of the core height so\n            // the top hemisphere alternately sees strong absorption\n            // (rod in) and free water (rod out).\n            let period = 8.0; // seconds\n            let t_osc = self.time;\n            self.rod_depth = 0.50 + 0.35 * (2.0 * std::f64::consts::PI * t_osc / period).sin();\n        }\n\n        // ── Diffusion sub-steps ───────────────────────────────────────\n        for _ in 0..sub_steps {\n            let phi_old = self.phi.clone();\n\n            for j in 1..N - 1 {\n                for i in 1..N - 1 {\n                    let idx = j * N + i;\n                    let base = self.region[idx];\n\n                    let (d, sa, nusf) = material_at(\n                        i, j, base, self.rod_depth,\n                    );\n\n                    // Five-point Laplacian ∇²φ (unit grid spacing).\n                    let lap = phi_old[idx + 1] + phi_old[idx - 1]\n                            + phi_old[(j + 1) * N + i]\n                            + phi_old[(j - 1) * N + i]\n                            - 4.0 * phi_old[idx];\n\n                    // Sum of delayed-neutron precursor decay: Σ λᵢ Cᵢ.\n                    let delayed_src: f64 = (0..6)\n                        .map(|g| LAMBDA[g] * self.precursors[g][idx])\n                        .sum();\n\n                    // External source (localised off-centre).\n                    let src = if i == SOURCE_X && j == SOURCE_Y {\n                        SOURCE_STRENGTH\n                    } else {\n                        0.0\n                    };\n\n                    // Diffusion equation (explicit Euler):\n                    //   dφ/dt = v [ D∇²φ − Σₐ φ + (1−β) νΣ_f φ + Σ λᵢCᵢ ] + S\n                    let dphi = V * (\n                        d * lap\n                        - sa * phi_old[idx]\n                        + (1.0 - BETA_TOTAL) * nusf * phi_old[idx]\n                        + delayed_src\n                    ) + src;\n\n                    self.phi[idx] = (phi_old[idx] + dphi * dt).max(0.0);\n\n                    // Update precursor concentrations (explicit Euler):\n                    //   dCᵢ/dt = βᵢ νΣ_f φ − λᵢ Cᵢ\n                    for g in 0..6 {\n                        let dc = BETA[g] * nusf * phi_old[idx]\n                               - LAMBDA[g] * self.precursors[g][idx];\n                        self.precursors[g][idx] =\n                            (self.precursors[g][idx] + dc * dt).max(0.0);\n                    }\n                }\n            }\n        }\n\n        // ── Compute k_eff ─────────────────────────────────────────────\n        // Raw k_eff from material balance (noisy during early transient).\n        self.k_eff = compute_k_eff(&self.phi, &self.region, self.rod_depth);\n        // Exponential moving average (α = 0.05) for a stable display.\n        self.k_eff_smooth = 0.95 * self.k_eff_smooth + 0.05 * self.k_eff;\n        self.frame += 1;\n\n        // ── Find flux range for colour mapping ────────────────────────\n        let mut max_phi: f64 = 1e-30;\n        for j in 0..N {\n            for i in 0..N {\n                let idx = j * N + i;\n                max_phi = max_phi.max(self.phi[idx]);\n            }\n        }\n        let log_max = (max_phi + 1e-30).ln();\n        let log_min = (max_phi * 1e-6 + 1e-30).ln();\n        let log_range = (log_max - log_min).max(1e-10);\n\n        // ── Render canvas ─────────────────────────────────────────────\n        // Left 20 px: k_eff gauge.  Right 400 px: 200×200 grid → 2× scale.\n\n        let rod_depth = self.rod_depth;\n        let k_eff = self.k_eff_smooth;\n        let phi = &self.phi;\n        let region = &self.region;\n\n        Canvas::from_fn(CANVAS_W, CANVAS_H, |px, py| {\n            // ── k_eff gauge (left strip) ──────────────────────────────\n            if px < GAUGE_W {\n                // Gauge maps k ∈ [0, 2] to the full canvas height.\n                // Bottom of canvas = k=0, top = k=2.\n                let k_at_row = 2.0 * (1.0 - py as f64 / CANVAS_H as f64);\n\n                // Criticality marker (k = 1.0): white horizontal line.\n                let k1_y = (CANVAS_H as f64 * 0.5) as u32; // k=1 is at 50%\n                if py >= k1_y.saturating_sub(1) && py <= k1_y + 1 {\n                    return (255, 255, 255);\n                }\n\n                // Current k_eff needle: bright white line.\n                let k_y = ((1.0 - k_eff / 2.0) * CANVAS_H as f64) as u32;\n                if py >= k_y.saturating_sub(2) && py <= k_y + 2 {\n                    return (255, 255, 255);\n                }\n\n                // Filled gauge up to current k_eff.\n                if k_at_row <= k_eff {\n                    // Narrow the bar slightly for aesthetics (2px border).\n                    if px >= 2 && px < GAUGE_W - 2 {\n                        return k_color(k_at_row);\n                    }\n                }\n\n                // Dark background for gauge.\n                return (20, 20, 25);\n            }\n\n            // ── Simulation area (right 400 px) ───────────────────────\n            let sim_x = px - GAUGE_W;\n            let i = (sim_x / 2) as usize;\n            let j = (py / 2) as usize;\n\n            if i >= N || j >= N {\n                return (0, 0, 0);\n            }\n\n            let idx = j * N + i;\n            let base = region[idx];\n\n            match base {\n                BaseRegion::Void => {\n                    // Dim warm glow for leaked neutrons in void.\n                    let flux = phi[idx];\n                    if flux > 1e-20 {\n                        let t = ((flux.ln() - log_min) / log_range)\n                            .clamp(0.0, 1.0);\n                        let v = (t * 50.0) as u8;\n                        (v, v / 2, v / 4)\n                    } else {\n                        (10, 10, 15)\n                    }\n                }\n                BaseRegion::Reflector => {\n                    // Teal tint for reflector (water/graphite).\n                    let flux = phi[idx];\n                    let t = if flux > 0.0 {\n                        ((flux.ln() - log_min) / log_range).clamp(0.0, 1.0)\n                    } else {\n                        0.0\n                    };\n                    let b = (25.0 + t * 70.0) as u8;\n                    (b / 6, b / 2, b)\n                }\n                BaseRegion::Fuel => {\n                    let flux = phi[idx];\n                    let t = if flux > 0.0 {\n                        ((flux.ln() - log_min) / log_range).clamp(0.0, 1.0)\n                    } else {\n                        0.0\n                    };\n                    plasma(t)\n                }\n                BaseRegion::RodChannel => {\n                    // Determine if rod or water at this position.\n                    let core_top = CENTER as f64 - R_CORE as f64;\n                    let rod_end = core_top + rod_depth * 2.0 * R_CORE as f64;\n                    if (j as f64) < rod_end {\n                        // Rod present: silver-red tint (Ag-In-Cd alloy).\n                        let flux = phi[idx];\n                        let t = if flux > 0.0 {\n                            ((flux.ln() - log_min) / log_range)\n                                .clamp(0.0, 1.0)\n                        } else {\n                            0.0\n                        };\n                        let base = 80.0 + t * 40.0;\n                        ((base * 1.1) as u8, (base * 0.7) as u8, (base * 0.75) as u8)\n                    } else {\n                        // Water channel: light blue tint.\n                        let flux = phi[idx];\n                        let t = if flux > 0.0 {\n                            ((flux.ln() - log_min) / log_range)\n                                .clamp(0.0, 1.0)\n                        } else {\n                            0.0\n                        };\n                        let b = (40.0 + t * 100.0) as u8;\n                        (b / 4, b / 3, b)\n                    }\n                }\n            }\n        })\n    }\n\n    fn fps() -> u32 {\n        30\n    }\n}\n",
      "cargo_toml": null
    }
  ]
}
