 opacity=\\\"1\\\" fill=\\\"#E94560\\\" stroke=\\\"none\\\" stroke-width=\\\"1\\\"/>\\n<circle cx=\\\"365\\\" cy=\\\"141\\\" r=\\\"4\\\" opacity=\\\"1\\\" fill=\\\"#E94560\\\" stroke=\\\"none\\\" stroke-width=\\\"1\\\"/>\\n<circle cx=\\\"453\\\" cy=\\\"113\\\" r=\\\"4\\\" opacity=\\\"1\\\" fill=\\\"#E94560\\\" stroke=\\\"none\\\" stroke-width=\\\"1\\\"/>\\n<circle cx=\\\"541\\\" cy=\\\"90\\\" r=\\\"4\\\" opacity=\\\"1\\\" fill=\\\"#E94560\\\" stroke=\\\"none\\\" stroke-width=\\\"1\\\"/>\\n<circle cx=\\\"629\\\" cy=\\\"71\\\" r=\\\"4\\\" opacity=\\\"1\\\" fill=\\\"#E94560\\\" stroke=\\\"none\\\" stroke-width=\\\"1\\\"/>\\n<circle cx=\\\"718\\\" cy=\\\"54\\\" r=\\\"4\\\" opacity=\\\"1\\\" fill=\\\"#E94560\\\" stroke=\\\"none\\\" stroke-width=\\\"1\\\"/>\\n<text x=\\\"100\\\" y=\\\"316\\\" dy=\\\"0.76em\\\" text-anchor=\\\"start\\\" font-family=\\\"sans-serif\\\" font-size=\\\"8.064516129032258\\\" opacity=\\\"1\\\" fill=\\\"#EAEAEA\\\">\\n0.0\\n</text>\\n<text x=\\\"189\\\" y=\\\"229\\\" dy=\\\"0.76em\\\" text-anchor=\\\"start\\\" font-family=\\\"sans-serif\\\" font-size=\\\"8.064516129032258\\\" opacity=\\\"1\\\" fill=\\\"#EAEAEA\\\">\\n1200.0\\n</text>\\n<text x=\\\"277\\\" y=\\\"178\\\" dy=\\\"0.76em\\\" text-anchor=\\\"start\\\" font-family=\\\"sans-serif\\\" font-size=\\\"8.064516129032258\\\" opacity=\\\"1\\\" fill=\\\"#EAEAEA\\\">\\n1902.0\\n</text>\\n<text x=\\\"365\\\" y=\\\"141\\\" dy=\\\"0.76em\\\" text-anchor=\\\"start\\\" font-family=\\\"sans-serif\\\" font-size=\\\"8.064516129032258\\\" opacity=\\\"1\\\" fill=\\\"#EAEAEA\\\">\\n2400.0\\n</text>\\n<text x=\\\"453\\\" y=\\\"113\\\" dy=\\\"0.76em\\\" text-anchor=\\\"start\\\" font-family=\\\"sans-serif\\\" font-size=\\\"8.064516129032258\\\" opacity=\\\"1\\\" fill=\\\"#EAEAEA\\\">\\n2786.3\\n</text>\\n<text x=\\\"541\\\" y=\\\"90\\\" dy=\\\"0.76em\\\" text-anchor=\\\"start\\\" font-family=\\\"sans-serif\\\" font-size=\\\"8.064516129032258\\\" opacity=\\\"1\\\" fill=\\\"#EAEAEA\\\">\\n3102.0\\n</text>\\n<text x=\\\"629\\\" y=\\\"71\\\" dy=\\\"0.76em\\\" text-anchor=\\\"start\\\" font-family=\\\"sans-serif\\\" font-size=\\\"8.064516129032258\\\" opacity=\\\"1\\\" fill=\\\"#EAEAEA\\\">\\n3368.8\\n</text>\\n<text x=\\\"718\\\" y=\\\"54\\\" dy=\\\"0.76em\\\" text-anchor=\\\"start\\\" font-family=\\\"sans-serif\\\" font-size=\\\"8.064516129032258\\\" opacity=\\\"1\\\" fill=\\\"#EAEAEA\\\">\\n3600.0\\n</text>\\n</svg>\\n\"}]"
