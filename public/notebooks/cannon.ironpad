.3,239.9 290.7,239.1 296.9,238.5 303.1,237.9 309.1,237.4 315.1,236.9 320.9,236.5 326.6,236.2 332.3,235.9 337.9,235.6 343.3,235.5 348.7,235.3 354.1,235.3 359.3,235.2 364.4,235.3 369.5,235.3 374.5,235.5 379.5,235.6 384.4,235.9 389.2,236.1 393.9,236.4 398.6,236.8 403.2,237.2 407.8,237.7 412.3,238.2 416.7,238.7 421.1,239.3 425.4,239.9 429.7,240.6 433.9,241.3 438.1,242.1 442.2,242.9 446.3,243.7 450.4,244.6 454.3,245.5 458.3,246.5 462.2,247.5 466.0,248.5 469.8,249.6 473.6,250.7 477.3,251.8 481.0,253.0 484.6,254.3 488.2,255.5 491.8,256.8 495.3,258.2 498.8,259.6 502.3,261.0 505.7,262.4 509.1,263.9 512.4,265.4 515.7,267.0 519.0,268.6 522.2,270.2 525.4,271.8 528.6,273.5 531.7,275.3 534.8,277.0 537.9,278.8 541.0,280.6 544.0,282.5 547.0,284.4 549.9,286.3 552.8,288.2 555.7,290.2 558.6,292.2 561.4,294.2\\\" fill=\\\"none\\\" stroke=\\\"#ff5da2\\\" stroke-width=\\\"2\\\"/>\\n<polyline points=\\\"30.0,295.0 43.2,291.3 56.0,287.8 68.3,284.5 80.1,281.4 91.5,278.4 102.6,275.6 113.3,272.9 123.7,270.3 133.8,267.9 143.6,265.5 153.1,263.3 162.4,261.2 171.4,259.3 180.2,257.4 188.8,255.6 197.1,253.9 205.3,252.3 213.3,250.8 221.1,249.3 228.7,248.0 236.1,246.7 243.4,245.5 250.6,244.4 257.6,243.3 264.5,242.4 271.2,241.5 277.8,240.6 284.3,239.8 290.7,239.1 296.9,238.5 303.1,237.9 309.1,237.4 315.1,236.9 320.9,236.5 326.6,236.2 332.3,235.9 337.9,235.6 343.3,235.4 348.7,235.3 354.0,235.2 359.3,235.2 364.4,235.2 369.5,235.3 374.5,235.4 379.5,235.6 384.4,235.8 389.2,236.1 393.9,236.4 398.6,236.8 403.2,237.2 407.8,237.6 412.3,238.1 416.7,238.7 421.1,239.3 425.4,239.9 429.7,240.6 433.9,241.3 438.1,242.0 442.2,242.8 446.3,243.7 450.4,244.5 454.3,245.5 458.3,246.4 462.2,247.4 466.0,248.5 469.8,249.5 473.6,250.7 477.3,251.8 481.0,253.0 484.6,254.2 488.2,255.5 491.8,256.8 495.3,258.1 498.8,259.5 502.3,260.9 505.7,262.4 509.1,263.9 512.4,265.4 515.7,266.9 519.0,268.5 522.2,270.2 525.4,271.8 528.6,273.5 531.7,275.2 534.8,277.0 537.9,278.8 541.0,280.6 544.0,282.4 546.9,284.3 549.9,286.2 552.8,288.2 555.7,29