2.0,36.3\\\" fill=\\\"none\\\" stroke=\\\"#e0d060\\\" stroke-width=\\\"2.5\\\"/><circle cx=\\\"152.7\\\" cy=\\\"294.0\\\" r=\\\"5\\\" fill=\\\"#4fc3f7\\\" stroke=\\\"#14141e\\\" stroke-width=\\\"1.5\\\"/><text x=\\\"152.7\\\" y=\\\"282.0\\\" fill=\\\"#4fc3f7\\\" font-size=\\\"12\\\" font-weight=\\\"bold\\\" text-anchor=\\\"middle\\\">flat  17.1°</text><circle cx=\\\"443.5\\\" cy=\\\"294.0\\\" r=\\\"5\\\" fill=\\\"#ff5da2\\\" stroke=\\\"#14141e\\\" stroke-width=\\\"1.5\\\"/><text x=\\\"443.5\\\" y=\\\"282.0\\\" fill=\\\"#ff5da2\\\" font-size=\\\"12\\\" font-weight=\\\"bold\\\" text-anchor=\\\"middle\\\">lofted  50.5°</text><text x=\\\"398.0\\\" y=\\\"334.0\\\" fill=\\\"#8a8aa0\\\" font-size=\\\"11\\\" text-anchor=\\\"middle\\\">launch angle (rad)</text><text x=\\\"14\\\" y=\\\"160.0\\\" fill=\\\"#8a8aa0\\\" font-size=\\\"11\\\" text-anchor=\\\"middle\\\" transform=\\\"rotate(-90 14 160.0)\\\">|miss| (m)</text><circle cx=\\\"528.0\\\" cy=\\\"28.0\\\" r=\\\"4\\\" fill=\\\"#4fc3f7\\\"/><text x=\\\"536.0\\\" y=\\\"32.0\\\" fill=\\\"#8a8aa0\\\" font-size=\\\"11\\\">flat basin</text><circle cx=\\\"624.0\\\" cy=\\\"28.0\\\" r=\\\"4\\\" fill=\\\"#ff5da2\\\"/><text x=\\\"632.0\\\" y=\\\"32.0\\\" fill=\\\"#8a8aa0\\\" font-size=\\\"11\\\">lofted basin</text></svg>\"}]"
