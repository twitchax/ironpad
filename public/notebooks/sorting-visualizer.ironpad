{
  "version": 1,
  "id": "00000000-0000-0000-0000-000000000204",
  "title": "Sorting Visualizer",
  "created_at": "2026-01-01T00:00:00Z",
  "updated_at": "2026-01-01T00:00:00Z",
  "shared_cargo_toml": "[profile.release]\nopt-level = 1\nlto = false\ncodegen-units = 16",
  "description": "Watch quicksort partition and conquer an array of 100 bars in real-time with a live statistics dashboard.",
