  "shared_cargo_toml": "[profile.release]\nopt-level = 1\nlto = false\ncodegen-units = 16",
  "description": "Interactively compare Quicksort, Bubble Sort, and Insertion Sort with adjustable array size and a live statistics dashboard.",
  "tags": [
    "algorithm",
