{
  "version": 1,
  "id": "00000000-0000-0000-0000-000000000110",
  "title": "Ray Marching",
  "created_at": "2026-01-01T00:00:00Z",
  "updated_at": "2026-01-01T00:00:00Z",
  "shared_cargo_toml": "[profile.release]\nopt-level = 1\nlto = false\ncodegen-units = 16",
  "shared_source": "// \u2500\u2500 Vec3 Math \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n#[derive(Clone, Copy)]\npub struct Vec3 {\n    pub x: f64,\n    pub y: f64,\n    pub z: f64,\n}\n\nimpl Vec3 {\n    pub fn new(x: f64, y: f64, z: f64) -> Self {\n        Self { x, y, z }\n    }\n\n    pub fn splat(v: f64) -> Self {\n        Self { x: v, y: v, z: v }\n    }\n\n    pub fn dot(self, o: Self) -> f64 {\n        self.x * o.x + self.y * o.y + self.z * o.z\n    }\n\n    pub fn length(self) -> f64 {\n        self.dot(self).sqrt()\n    }\n\n    pub fn normalize(self) -> Self {\n        let l = self.length();\n        if l < 1e-10 {\n            return Self::splat(0.0);\n        }\n        Self {\n            x: self.x / l,\n            y: self.y / l,\n            z: self.z / l,\n        }\n    }\n\n    pub fn cross(self, o: Self) -> Self {\n        Self {\n            x: self.y * o.z - self.z * o.y,\n            y: self.z * o.x - self.x * o.z,\n            z: self.x * o.y - self.y * o.x,\n        }\n    }\n\n    pub fn abs(self) -> Self {\n        Self {\n            x: self.x.abs(),\n            y: self.y.abs(),\n            z: self.z.abs(),\n        }\n    }\n\n    pub fn reflect(self, n: Self) -> Self {\n        self - n * (2.0 * self.dot(n))\n    }\n}\n\nimpl std::ops::Add for Vec3 {\n    type Output = Self;\n    fn add(self, o: Self) -> Self {\n        Self { x: self.x + o.x, y: self.y + o.y, z: self.z + o.z }\n    }\n}\n\nimpl std::ops::Sub for Vec3 {\n    type Output = Self;\n    fn sub(self, o: Self) -> Self {\n        Self { x: self.x - o.x, y: self.y - o.y, z: self.z - o.z }\n    }\n}\n\nimpl std::ops::Mul<f64> for Vec3 {\n    type Output = Self;\n    fn mul(self, s: f64) -> Self {\n        Self { x: self.x * s, y: self.y * s, z: self.z * s }\n    }\n}\n\nimpl std::ops::Neg for Vec3 {\n    type Output = Self;\n    fn neg(self) -> Self {\n        Self { x: -self.x, y: -self.y, z: -self.z }\n    }\n}\n\n// \u2500\u2500 SDF Primitives \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\npub fn sdf_sphere(p: Vec3, center: Vec3, radius: f64) -> f64 {\n    (p - center).length() - radius\n}\n\npub fn sdf_plane(p: Vec3, height: f64) -> f64 {\n    p.y - height\n}\n\npub fn sdf_box(p: Vec3, center: Vec3, half_size: Vec3) -> f64 {\n    let d = (p - center).abs();\n    let dx = (d.x - half_size.x).max(0.0);\n    let dy = (d.y - half_size.y).max(0.0);\n    let dz = (d.z - half_size.z).max(0.0);\n    let outside = (dx * dx + dy * dy + dz * dz).sqrt();\n    let inside = (d.x - half_size.x)\n        .max((d.y - half_size.y).max(d.z - half_size.z))\n        .min(0.0);\n    outside + inside\n}\n\n// \u2500\u2500 CSG Operations \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\npub fn op_union(a: f64, b: f64) -> f64 {\n    a.min(b)\n}\n\npub fn op_smooth_union(a: f64, b: f64, k: f64) -> f64 {\n    let h = (0.5 + 0.5 * (b - a) / k).clamp(0.0, 1.0);\n    b * (1.0 - h) + a * h - k * h * (1.0 - h)\n}\n\n// \u2500\u2500 Normal Estimation \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\npub fn estimate_normal(p: Vec3, scene_fn: impl Fn(Vec3) -> f64) -> Vec3 {\n    let e = 0.0005;\n    Vec3::new(\n        scene_fn(Vec3::new(p.x + e, p.y, p.z)) - scene_fn(Vec3::new(p.x - e, p.y, p.z)),\n        scene_fn(Vec3::new(p.x, p.y + e, p.z)) - scene_fn(Vec3::new(p.x, p.y - e, p.z)),\n        scene_fn(Vec3::new(p.x, p.y, p.z + e)) - scene_fn(Vec3::new(p.x, p.y, p.z - e)),\n    )\n    .normalize()\n}\n\n// \u2500\u2500 Ray Marching \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\npub fn ray_march(\n    ro: Vec3,\n    rd: Vec3,\n    max_steps: u32,\n    scene_fn: impl Fn(Vec3) -> f64,\n) -> Option<(f64, Vec3)> {\n    let mut t = 0.0;\n    for _ in 0..max_steps {\n        let p = ro + rd * t;\n        let d = scene_fn(p);\n        if d < 0.001 {\n            return Some((t, p));\n        }\n        t += d;\n        if t > 100.0 {\n            break;\n        }\n    }\n    None\n}\n\n// \u2500\u2500 Phong Lighting \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\npub fn phong(normal: Vec3, view_dir: Vec3, light_dir: Vec3, base_color: Vec3) -> Vec3 {\n    let ambient = base_color * 0.12;\n    let diff = normal.dot(light_dir).max(0.0);\n    let diffuse = base_color * (diff * 0.65);\n    let half_vec = (light_dir + view_dir).normalize();\n    let spec = normal.dot(half_vec).max(0.0).powf(48.0);\n    let specular = Vec3::splat(spec * 0.4);\n    ambient + diffuse + specular\n}\n\n// \u2500\u2500 Soft Shadows \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\npub fn soft_shadow(\n    origin: Vec3,\n    light_dir: Vec3,\n    k: f64,\n    scene_fn: impl Fn(Vec3) -> f64,\n) -> f64 {\n    let mut res = 1.0_f64;\n    let mut t = 0.02;\n    for _ in 0..48 {\n        let d = scene_fn(origin + light_dir * t);\n        if d < 0.001 {\n            return 0.0;\n        }\n        res = res.min(k * d / t);\n        t += d.max(0.01);\n        if t > 25.0 {\n            break;\n        }\n    }\n    res.clamp(0.0, 1.0)\n}\n\n// \u2500\u2500 Sky Background \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\npub fn sky_color(rd: Vec3) -> Vec3 {\n    let t = 0.5 * (rd.y + 1.0);\n    Vec3::new(0.08, 0.08, 0.18) * (1.0 - t) + Vec3::new(0.25, 0.35, 0.65) * t\n}\n\n// \u2500\u2500 Color Utilities \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\npub fn to_rgb(c: Vec3) -> (u8, u8, u8) {\n    let r = c.x.clamp(0.0, 1.0).powf(1.0 / 2.2);\n    let g = c.y.clamp(0.0, 1.0).powf(1.0 / 2.2);\n    let b = c.z.clamp(0.0, 1.0).powf(1.0 / 2.2);\n    ((r * 255.0) as u8, (g * 255.0) as u8, (b * 255.0) as u8)\n}\n\n// \u2500\u2500 Camera Setup \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\npub struct Camera {\n    pub pos: Vec3,\n    pub fwd: Vec3,\n    pub right: Vec3,\n    pub up: Vec3,\n}\n\nimpl Camera {\n    pub fn look_at(pos: Vec3, target: Vec3) -> Self {\n        let fwd = (target - pos).normalize();\n        let world_up = Vec3::new(0.0, 1.0, 0.0);\n        let right = fwd.cross(world_up).normalize();\n        let up = right.cross(fwd);\n        Self { pos, fwd, right, up }\n    }\n\n    pub fn ray(&self, u: f64, v: f64, aspect: f64) -> Vec3 {\n        (self.fwd + self.right * (u * aspect * 0.5) + self.up * (v * 0.5)).normalize()\n    }\n}\n",
  "cells": [
    {
      "id": "cell_0",
      "order": 0,
      "label": "Introduction",
      "cell_type": "Markdown",
      "source": "# Ray Marching\n\n**Ray marching** is a rendering technique that traces rays through a scene defined by **signed distance functions (SDFs)**. Unlike traditional ray tracing, which intersects rays with explicit geometry (triangles, spheres), ray marching *steps along each ray* using the distance to the nearest surface.\n\n## The Algorithm\n\nFor each pixel:\n1. Cast a ray from the camera through the pixel\n2. Start at the camera position and repeatedly:\n   - Evaluate the SDF at the current point \u2192 get the distance `d` to the nearest surface\n   - Step forward along the ray by `d` (we know nothing is closer than `d`)\n   - If `d` is very small, we've hit a surface \u2014 compute lighting\n   - If we've traveled too far, the ray missed everything \u2014 draw sky\n\n## Signed Distance Functions\n\nAn SDF `f(p)` returns the shortest distance from point `p` to a surface:\n- **Positive**: outside the object\n- **Negative**: inside the object\n- **Zero**: exactly on the surface\n\nSimple SDFs: `sphere(p, r) = |p| - r`, `plane(p) = p.y`.\n\nThe magic is **composability** \u2014 you can combine SDFs with union (`min`), intersection (`max`), and smooth blending to create complex scenes from simple primitives.",
      "cargo_toml": null
    },
    {
      "id": "cell_1",
      "order": 1,
      "label": "Basic Scene",
      "cell_type": "Code",
      "source": "use ironpad_cell::prelude::*;\n\n// Scene: a red sphere floating above a checkerboard plane, lit with Phong shading.\n\nfn scene(p: shared::Vec3) -> f64 {\n    let sphere = shared::sdf_sphere(p, shared::Vec3::new(0.0, 1.0, 0.0), 1.0);\n    let plane = shared::sdf_plane(p, 0.0);\n    shared::op_union(sphere, plane)\n}\n\nfn material_color(p: shared::Vec3) -> shared::Vec3 {\n    if p.y < 0.01 {\n        // Checkerboard pattern on the ground plane\n        let checker = ((p.x.floor() as i32) + (p.z.floor() as i32)) & 1 == 0;\n        if checker {\n            shared::Vec3::new(0.35, 0.35, 0.4)\n        } else {\n            shared::Vec3::new(0.15, 0.15, 0.2)\n        }\n    } else {\n        shared::Vec3::new(0.85, 0.2, 0.15)\n    }\n}\n\nlet (w, h) = (320usize, 240usize);\nlet aspect = w as f64 / h as f64;\n\nlet cam = shared::Camera::look_at(\n    shared::Vec3::new(0.0, 2.5, 5.0),\n    shared::Vec3::new(0.0, 0.8, 0.0),\n);\nlet light_dir = shared::Vec3::new(-1.0, 2.0, 1.5).normalize();\n\nlet canvas = Canvas::from_fn(w as u32, h as u32, |px, py| {\n    let u = (px as f64 + 0.5) / w as f64 * 2.0 - 1.0;\n    let v = -((py as f64 + 0.5) / h as f64 * 2.0 - 1.0);\n    let rd = cam.ray(u, v, aspect);\n\n    let color = match shared::ray_march(cam.pos, rd, 128, scene) {\n        Some((_, hit)) => {\n            let n = shared::estimate_normal(hit, scene);\n            let view = (cam.pos - hit).normalize();\n            shared::phong(n, view, light_dir, material_color(hit))\n        }\n        None => shared::sky_color(rd),\n    };\n\n    shared::to_rgb(color)\n});\n\nCellOutput::from(canvas)\n",
      "cargo_toml": null
    },
    {
      "id": "cell_2",
      "order": 2,
      "label": "Soft Shadows",
      "cell_type": "Code",
      "source": "use ironpad_cell::prelude::*;\n\n// Enhanced scene: sphere + rounded box with smooth CSG union and soft shadows.\n\nfn scene(p: shared::Vec3) -> f64 {\n    let sphere = shared::sdf_sphere(p, shared::Vec3::new(-1.2, 1.0, 0.0), 0.9);\n    let bx = shared::sdf_box(\n        p,\n        shared::Vec3::new(1.2, 0.8, 0.0),\n        shared::Vec3::new(0.6, 0.6, 0.6),\n    );\n    let objects = shared::op_smooth_union(sphere, bx, 0.4);\n    let plane = shared::sdf_plane(p, 0.0);\n    shared::op_union(objects, plane)\n}\n\nfn material_color(p: shared::Vec3) -> shared::Vec3 {\n    if p.y < 0.01 {\n        let checker = ((p.x.floor() as i32) + (p.z.floor() as i32)) & 1 == 0;\n        if checker {\n            shared::Vec3::new(0.30, 0.30, 0.35)\n        } else {\n            shared::Vec3::new(0.12, 0.12, 0.18)\n        }\n    } else if p.x < 0.0 {\n        shared::Vec3::new(0.2, 0.55, 0.85) // Blue sphere\n    } else {\n        shared::Vec3::new(0.9, 0.65, 0.15) // Gold box\n    }\n}\n\nlet (w, h) = (320usize, 240usize);\nlet aspect = w as f64 / h as f64;\n\nlet cam = shared::Camera::look_at(\n    shared::Vec3::new(0.0, 3.0, 6.0),\n    shared::Vec3::new(0.0, 0.8, 0.0),\n);\nlet light_dir = shared::Vec3::new(-1.0, 2.5, 2.0).normalize();\n\nlet canvas = Canvas::from_fn(w as u32, h as u32, |px, py| {\n    let u = (px as f64 + 0.5) / w as f64 * 2.0 - 1.0;\n    let v = -((py as f64 + 0.5) / h as f64 * 2.0 - 1.0);\n    let rd = cam.ray(u, v, aspect);\n\n    let color = match shared::ray_march(cam.pos, rd, 128, scene) {\n        Some((_, hit)) => {\n            let n = shared::estimate_normal(hit, scene);\n            let view = (cam.pos - hit).normalize();\n            let base = material_color(hit);\n            // Soft shadow from the light source\n            let shadow = shared::soft_shadow(hit + n * 0.01, light_dir, 16.0, scene);\n            let lit = shared::phong(n, view, light_dir, base);\n            // Darken by shadow factor, preserving some ambient\n            shared::Vec3::new(\n                lit.x * (0.15 + 0.85 * shadow),\n                lit.y * (0.15 + 0.85 * shadow),\n                lit.z * (0.15 + 0.85 * shadow),\n            )\n        }\n        None => shared::sky_color(rd),\n    };\n\n    shared::to_rgb(color)\n});\n\nCellOutput::from(canvas)\n",
      "cargo_toml": null
    },
    {
      "id": "cell_3",
      "order": 3,
      "label": "How It Works",
      "cell_type": "Markdown",
      "source": "## How It Works\n\n### Signed Distance Functions (SDFs)\n\nEach primitive is a simple function returning the distance to the nearest surface:\n\n| Primitive | SDF |\n|-----------|-----|\n| Sphere | `\\|p - center\\| - radius` |\n| Plane | `p.y - height` |\n| Box | `length(max(abs(p - center) - half_size, 0))` + interior term |\n\n### CSG Operations\n\nCombine primitives with set operations:\n- **Union**: `min(a, b)` \u2014 merges two objects\n- **Smooth union**: blends the surfaces with a smoothing factor `k`\n- **Intersection**: `max(a, b)` \u2014 keeps only the overlap\n- **Subtraction**: `max(a, -b)` \u2014 carves one from another\n\n### Extending the Renderer\n\nTry modifying the scene function to:\n- Add a **torus**: `sdf_torus(p, major_r, minor_r) = length(vec2(length(p.xz) - major_r, p.y)) - minor_r`\n- Use **repetition**: `sdf(mod(p, period) - period/2)` for infinite copies\n- Add **ambient occlusion**: sample the SDF at increasing distances from the surface along the normal",
      "cargo_toml": null
    }
  ]
}
