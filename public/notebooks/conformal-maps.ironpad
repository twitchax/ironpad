{
 "version": 1,
 "id": "00000000-0000-0000-0000-000000000301",
 "title": "Conformal Maps",
 "created_at": "2026-01-01T00:00:00Z",
 "updated_at": "2026-07-12T00:00:00Z",
 "shared_cargo_toml": "[profile.release]\nopt-level = 1\nlto = false\ncodegen-units = 16",
 "description": "Visualize how holomorphic functions transform grids in the complex plane while preserving angles between curves.",
 "tags": [
