# Build artifacts
/target
/data
/cache

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Node (for Playwright / Monaco)
node_modules/
package-lock.json

# Monaco editor dist (copied from node_modules by `cargo make setup-monaco`)
public/monaco/vs/

# Playwright
test-results/
playwright-report/

# Misc
*.log

# Fly.io (local deployment config)
.hidden/

# Coverage
coverage.lcov
*.lcov
.playwright-mcp/
__pycache__/

# Vendored Docker build inputs (fetched by `cargo make vendor-browserpod`).
# The BrowserPod toolchain tarball is 38MB and checksum-pinned in
# docker/browserpod.env, so fetching beats committing it.
docker/vendor/*
!docker/vendor/.gitkeep
