# BrowserPod Rust toolchain pin (PRD-0066).
#
# The ONE place these three strings live. `docker/vendor-browserpod.sh` sources
# it to fetch and verify the tarball; `docker/Dockerfile` copies it into the
# runtime stage and sources it again to install from the vendored copy; and
# `cell_toolchain` in crates/ironpad-app/src/compiler/build.rs must name the
# same toolchain. A second copy of the version string is a second thing to
# forget on the next bump.
#
# Sourced by `sh`, so: no spaces around `=`, no quotes needed, no bashisms.

# Toolchain pack version. Installs as the rustup toolchain
# `browserpod-$BROWSERPOD_VERSION`, discovered by directory listing under
# $RUSTUP_HOME/toolchains (no `rustup toolchain link` involved).
BROWSERPOD_VERSION=3.0.0

# sha256 of browserpod-rust-$BROWSERPOD_VERSION.tar.gz, as published in the
# vendor's own install.sh. Verified on both sides of the vendoring seam: once
# when fetching, once inside the image build, because the point of vendoring is
# that the second check no longer trusts the network.
BROWSERPOD_SHA256=435a3da928150027a074ddd20a001239b671ca590eeca6b12b41d432fe8c19db

# The nightly the pack pins underneath (its `nightly-pin` file). The pack's
# installer pulls this itself from static.rust-lang.org; recorded here so the
# image's fourth toolchain is visible where the other three are, rather than
# only inside a tarball.
BROWSERPOD_NIGHTLY=nightly-2026-05-19

# Where the tarball is fetched FROM. Overridable so the fetch can be pointed at
# a mirror we control: `rt.browserpod.io` being down should not be able to stop
# a production build, and vendoring only moves that dependency from image-build
# time to fetch time — it does not remove it until this points elsewhere.
BROWSERPOD_DIST_BASE=https://rt.browserpod.io/3.0.0/rust
